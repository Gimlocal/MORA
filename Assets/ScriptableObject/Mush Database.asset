  - mushId: 7
    mushName: "\uD3ED\uBC1C \uBC84\uC12F"
    value: 4
    description: "\uC8FC\uBCC0\uC758 \uAD11\uBB3C\uC744 \uB04C\uC5B4\uB4E4\uC5EC
