  - mushId: 6
    mushName: "\uAC15\uCCA0 \uBC84\uC12F"
    value: 2
    description: "\uAC15\uCCA0\uC758 \uB2E8\uB2E8\uD568\uACFC \uBC84\uC12F\uC758
